#!/bin/bash
# Publishes the palette Omarchy rendered from themed/herdr-app.json.tpl as
# Herdr's "omarchy" theme (settings.json selects it). Herdr reloads the file
# live. Port of omacom/omarchy PR 17118; delete once Omarchy ships it.
src="$HOME/.local/state/omarchy/current/theme/herdr-app.json"
home="${HERDR_APP_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr-app}"
dst="$home/themes/omarchy.json"

[[ -d $home ]] || exit 0
if [[ ! -f $src ]]; then
  echo "Skipping Herdr theme: this theme has no colors.toml to render." >&2
  exit 0
fi

# Same check as the upstream helper: Herdr only takes #rrggbb (#rrggbbaa in
# colors), so a palette with unresolved {{ }} or rgba() keeps the last good theme.
if ! jq -e '
  def rgb: type == "string" and test("^#[0-9a-fA-F]{6}$");
  def color: type == "string" and test("^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$");
  type == "object" and
  ((keys - ["background", "foreground", "selection", "cursor", "ansi", "colors"]) | length == 0) and
  (.background | rgb) and (.foreground | rgb) and (.selection | rgb) and
  ((.cursor // .foreground) | rgb) and
  (.ansi | type == "array" and length == 16 and all(.[]; rgb)) and
  (if has("colors") then (.colors | type == "object" and all(.[]; color)) else true end)
' "$src" >/dev/null 2>&1; then
  echo "Skipping Herdr theme: generated colors are invalid or unresolved." >&2
  exit 0
fi

cmp -s "$src" "$dst" && exit 0
mkdir -p "${dst%/*}"
tmp=$(mktemp "$dst.XXXXXX")
cp "$src" "$tmp" && chmod 644 "$tmp" && mv "$tmp" "$dst"
