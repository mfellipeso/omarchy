# Mister Download Manager theme rendered from the current Omarchy palette.
# Published to MDM's themes folder by hooks/theme-set.d/30-mdm.
name = "Omarchy"
inherits = "classic"
icons = "accent"

[seeds]
background = "{{ background }}"
surface = "{{ lighter_background }}"
header = "{{ dark_background }}"
text = "{{ foreground }}"
accent = "{{ accent }}"
selection = "{{ selection }}"
error = "{{ red }}"
warning = "{{ yellow }}"
success = "{{ green }}"
